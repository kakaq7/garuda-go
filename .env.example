# Isi melalui Vercel Project Settings > Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
# Gunakan secret server-side; jangan pernah expose service_role key ke browser.
SUPABASE_KEY=your-supabase-server-key
FLASK_SECRET_KEY=ganti-dengan-random-secret-yang-panjang
ADMIN_USERNAME=admin
# Pilih salah satu: password biasa untuk setup sederhana, atau hash di bawah.
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Lebih disarankan: set ADMIN_PASSWORD_HASH dan hapus ADMIN_PASSWORD.
# Buat hash dengan: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('PASSWORD_KUAT'))"
ADMIN_PASSWORD_HASH=
